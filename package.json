{
  "name": "tailormap-viewer",
  "scripts": {
    "ng": "ng",
    "start": "ng serve app",
    "start-nl": "ng serve app --configuration=nl",
    "start-de": "ng serve app --configuration=de",
    "build": "tm-build-application",
    "watch": "ng build --watch --configuration=development --localize app",
    "test": "ng test --no-watch",
    "test:ci": "ng test --no-watch --coverage --reporters=default --reporters=junit",
    "test-core": "ng test core --ui",
    "test-admin-core": "ng test admin-core --ui",
    "test-shared": "ng test shared --ui",
    "test-map": "ng test map --ui",
    "lint": "ng lint",
    "lint-fix": "ng lint --fix",
    "lint-per-rule": "eslint --ext .ts,.html -f ./lint-formatter.js ./projects/**",
    "release-packages": "tm-publish-all-libraries",
    "analyze-bundle": "ng build app --stats-json && mv dist/app/stats.json ./tailormap-bundle-stats.json && echo \"Open https://esbuild.github.io/analyze/ and use tailormap-bundle-stats.json to analyze\"",
    "extract-locale": "npm run extract-locale-shared && npm run extract-locale-core && npm run extract-locale-admin-core",
    "extract-locale-shared": "tm-extract-i18n --library=shared",
    "extract-locale-core": "tm-extract-i18n --library=core",
    "extract-locale-admin-core": "tm-extract-i18n --library=admin-core",
    "link-libraries": "tm-link-libraries"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/material": "^22.1.6",
    "@angular/material-luxon-adapter": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@ctrl/tinycolor": "^4.2.1",
    "@milkdown/core": "^7.22.1",
    "@milkdown/crepe": "^7.22.1",
    "@ngrx/operators": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@ngrx/store-devtools": "^22.0.0",
    "@nuintun/qrcode": "^5.0.3",
    "@stardazed/zlib": "^1.0.1",
    "@tinyhttp/content-disposition": "^2.2.4",
    "cesium": "^1.145.0",
    "fast-equals": "^6.0.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jsts": "^2.12.1",
    "luxon": "^3.7.2",
    "marked": "^18.0.12",
    "nanoid": "^6.0.1",
    "ol": "^10.10.0",
    "ol-ext": "^4.0.38",
    "olcs": "^2.23.1",
    "proj4": "^2.22.0",
    "rxjs": "^7.8.2",
    "svg2pdf.js": "^2.8.1",
    "tslib": "^2.8.1",
    "uuid": "^14.0.2",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/schematics": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.6",
    "@angular/localize": "^22.1.6",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailormap-viewer/schematics": "^0.0.18",
    "@tailormap-viewer/tools": "^0.0.33",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.13.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.11",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.3.8",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "git-describe": "^4.1.1",
    "inquirer": "^14.2.2",
    "jsdom": "^30.0.1",
    "ng-extract-i18n-merge": "^3.4.0",
    "ng-packagr": "^22.1.1",
    "tsutils-etc": "^1.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
